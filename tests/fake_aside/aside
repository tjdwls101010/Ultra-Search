#!/usr/bin/env python3
"""A stand-in for the `aside` binary.

It exists so the supervisor's state machine can be driven through situations the real
binary produces rarely or only by accident -- a run whose session never appears, a child
that outlives its parent, two identical prompts racing. Recording those as fixtures is
the only way to test them repeatedly.

Behaviour is chosen by FAKE_ASIDE_SCENARIO. Every invocation appends its argv to
$FAKE_ASIDE_CALLS/calls.jsonl so a contract test can assert what was actually run.

FAKE_ASIDE_REPLAY names a JSONL file of transcript records to write after the prompt,
for `exec` and for a resumed `exec --session` alike; a `{"__sleep__": SEC}` line pauses
the writer, so a run can be held open at any point of its transcript.

`repl` answers the page snippets from FAKE_ASIDE_REPL_ROUTES, a JSON file keyed by the
snippet named on the snippet's `// snippet: <name>` line and then by URL:

    fetch_batch, tab_one  URL -> a record, or {"sequence": [record, ...]} answered in
                          call order (the last one repeats). `url` is filled in.
    sitemap               candidate URL -> the page URLs that sitemap lists
    links                 page URL -> the raw hrefs on that page

A URL with no route answers as the real browser would: fetch_batch gets an HTTP 404
page, tab_one a navigation error, sitemap a miss, links a miss.
"""
from __future__ import annotations

import json
import os
import random
import string
import sys
import time
from pathlib import Path

SCENARIO = os.environ.get("FAKE_ASIDE_SCENARIO", "simple")
HOME = Path(os.environ.get("ULTRA_SEARCH_ASIDE_HOME", "~/.aside")).expanduser()
SESSIONS = HOME / "u" / "0" / "sessions"


def record_call(argv: list[str]) -> None:
    d = os.environ.get("FAKE_ASIDE_CALLS")
    if not d:
        return
    p = Path(d) / "calls.jsonl"
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("a", encoding="utf-8") as f:
        f.write(json.dumps({"argv": argv, "scenario": SCENARIO, "at": time.time()}, ensure_ascii=False) + "\n")


def new_session_id() -> str:
    return "".join(random.choices(string.ascii_letters + string.digits, k=16))


def make_session(prompt: str, session_id: str | None = None) -> tuple[str, Path]:
    sid = session_id or new_session_id()
    d = SESSIONS / f"{time.strftime('%Y-%m-%d')}_{sid}"
    d.mkdir(parents=True, exist_ok=True)
    rec = {"role": "user", "content": [{"type": "text", "text": prompt}], "timestamp": int(time.time() * 1000)}
    append(d, rec)
    return sid, d


def append(d: Path, rec: dict) -> None:
    with (d / "messages.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        f.flush()
        os.fsync(f.fileno())


def usage(total: int = 1000) -> dict:
    return {
        "input": total // 2, "output": 20, "cacheRead": 0, "cacheWrite": 0,
        "reasoning": 0, "totalTokens": total, "cost": {"total": 0.01},
    }


def assistant(texts=None, calls=None, stop="stop") -> dict:
    content = []
    for name, args in calls or []:
        content.append({"type": "toolCall", "name": name, "arguments": args})
    for t in texts or []:
        content.append({"type": "text", "text": t})
    return {"role": "assistant", "content": content, "stopReason": stop,
            "usage": usage(), "timestamp": int(time.time() * 1000)}


def tool_result(name: str, content: str, details: dict | None = None) -> dict:
    return {"role": "toolResult", "toolName": name, "content": content, "details": details or {},
            "isError": False, "toolCallId": "call_fake", "timestamp": int(time.time() * 1000)}


SEARCH_SOURCES = {"sources": [
    {"id": "src1", "url": "https://example.org/a", "title": "Example A", "excerpt": "…"},
    {"id": "src2", "url": "https://example.org/b", "title": "Example B", "excerpt": "…"},
]}


def replay(d: Path) -> bool:
    """Write the records from FAKE_ASIDE_REPLAY after the prompt already in ``d``.

    A recorded session's own opening prompt is skipped: the prompt this run was given, with
    its marker, is already there, exactly as the real binary writes it. A recording that
    ends without a newline ends the same way here -- half a record, as a transcript looks
    while its writer is mid-line.
    """
    source = os.environ.get("FAKE_ASIDE_REPLAY")
    if not source:
        return False
    text = Path(source).read_text(encoding="utf-8")
    lines = text.splitlines()
    opening = True
    for i, line in enumerate(lines):
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except ValueError:
            rec = None
        role = rec.get("role") if isinstance(rec, dict) else None
        if isinstance(rec, dict) and "__sleep__" in rec:
            time.sleep(float(rec["__sleep__"]))
            continue
        if opening and role == "user":
            opening = False
            continue
        if role in ("assistant", "toolResult"):
            opening = False
        torn = i == len(lines) - 1 and not text.endswith("\n")
        with (d / "messages.jsonl").open("a", encoding="utf-8") as f:
            f.write(line if torn else line + "\n")
    return True


def do_exec(prompt: str, session: str | None = None) -> int:
    if session:
        # Continuing an existing session: append to its transcript rather than creating a
        # new one. The real binary does this, and a fake that made a fresh session instead
        # would hide the fact that marker discovery cannot work on a resumed run.
        d = None
        for name in os.listdir(SESSIONS) if SESSIONS.is_dir() else []:
            if name.endswith("_" + session):
                d = SESSIONS / name
                break
        if d is None:
            print(f"no such session {session}", file=sys.stderr)
            return 1
        append(d, {"role": "user", "content": [{"type": "text", "text": prompt}],
                   "timestamp": int(time.time() * 1000)})
        if replay(d):
            return 0
        answer = "이어서 답합니다."
        # The reply can land after this process exits -- which is exactly when a supervisor
        # that stopped waiting would report the previous turn's answer instead.
        delay = float(os.environ.get("FAKE_ASIDE_RESUME_DELAY", "0"))
        if delay:
            if os.fork() == 0:
                time.sleep(delay)
                append(d, assistant(texts=[answer]))
                os._exit(0)
        else:
            append(d, assistant(texts=[answer]))
        print(answer)
        return 0

    if SCENARIO == "aside_down":
        print("Aside daemon is not reachable", file=sys.stderr)
        return 1

    if SCENARIO == "no_session":
        # The session never appears on disk: the supervisor has to fall back to stdout
        # alone rather than waiting forever for a correlation that will not happen.
        print("Thinking: working…")
        print("websearch(objective: 'x', search_queries: ['x'], mode: 'basic')")
        print(" > {\"session_id\":\"unknowable\",\"results\":[{\"url\":\"https://example.org/only-in-stdout\"}]}")
        time.sleep(float(os.environ.get("FAKE_ASIDE_DELAY", "0.3")))
        print("The answer, visible only in stdout.")
        return 0

    sid, d = make_session(prompt)
    print(f"Thinking: starting {sid}")
    sys.stdout.flush()

    if replay(d):
        return 0

    if SCENARIO == "slow":
        delay = float(os.environ.get("FAKE_ASIDE_DELAY", "3"))
        append(d, assistant(calls=[("websearch", {"objective": "slow", "search_queries": ["q"]})], stop="toolUse"))
        time.sleep(delay)
        append(d, tool_result("websearch", "results…", SEARCH_SOURCES))
        append(d, assistant(texts=["느린 답."]))
        print("느린 답.")
        return 0

    if SCENARIO in ("subagent", "orphan"):
        children = []
        append(d, assistant(calls=[("subagent", {"action": "spawn", "description": "c1"}),
                                   ("subagent", {"action": "spawn", "description": "c2"})], stop="toolUse"))
        for name in ("c1", "c2"):
            cid, cd = make_session(f"child task {name}")
            children.append((cid, cd))
            append(d, tool_result("subagent", "spawned", {"taskId": cid}))
        # One child finishes promptly; in the orphan scenario the other is still writing
        # when the parent process exits, which is exactly the case that must not be
        # reported as a clean completion.
        append(children[0][1], assistant(texts=["child 1 done."]))
        if SCENARIO == "subagent":
            append(children[1][1], assistant(texts=["child 2 done."]))
            append(d, assistant(texts=["부모 답: 자식 둘 완료."]))
            print("부모 답: 자식 둘 완료.")
            return 0
        os.environ["FAKE_ASIDE_ORPHAN_DIR"] = str(children[1][1])
        pid = os.fork()
        if pid == 0:
            time.sleep(float(os.environ.get("FAKE_ASIDE_ORPHAN_DELAY", "2")))
            append(children[1][1], assistant(texts=["child 2 finished late."]))
            os._exit(0)
        append(d, assistant(texts=["부모 답: 자식 하나가 아직."]))
        print("부모 답: 자식 하나가 아직.")
        return 0

    if SCENARIO == "fail":
        append(d, assistant(texts=[""], stop="error"))
        print("something went wrong", file=sys.stderr)
        return 1

    if SCENARIO == "empty":
        append(d, assistant(texts=[""]))
        return 0

    if SCENARIO == "negative":
        answer = "관련 사례를 찾지 못했습니다."
        append(d, assistant(texts=[answer]))
        print(answer)
        return 0

    # simple
    append(d, assistant(calls=[("websearch", {"objective": "o", "search_queries": ["q"]})], stop="toolUse"))
    append(d, tool_result("websearch", "results…", SEARCH_SOURCES))
    answer = 'Answer <citation refs="src1">Example A</citation>'
    append(d, assistant(texts=[answer]))
    print(answer)
    return 0


def do_repl(code: str) -> int:
    if SCENARIO == "aside_down":
        print("fetch failed: other side closed", file=sys.stderr)
        print("Aside daemon is not reachable", file=sys.stderr)
        return 1
    if SCENARIO == "repl_timeout":
        # The real daemon reports a 120s snippet overrun as though it had died.
        time.sleep(float(os.environ.get("FAKE_ASIDE_DELAY", "0.2")))
        print("fetch failed: other side closed", file=sys.stderr)
        print("Aside daemon is not reachable", file=sys.stderr)
        return 1

    snippet, args = snippet_of(code)
    if snippet is None:
        print(json.dumps({"ok": True, "pwd": str(HOME / "u" / "0" / "sessions" / "fake")}))
        return 0
    routes = load_routes().get(snippet) or {}
    for rec in SNIPPETS[snippet](args, routes):
        print(json.dumps(rec, ensure_ascii=False))
        sys.stdout.flush()
    return 0


def snippet_of(code: str) -> tuple[str | None, dict]:
    """The snippet named by its tag line, and the ARGS the caller prepended."""
    lines = code.splitlines()
    args: dict = {}
    if lines and lines[0].startswith("const ARGS = "):
        args = json.loads(lines[0][len("const ARGS = "):].rstrip().rstrip(";"))
    for line in lines[:3]:
        if line.startswith("// snippet:"):
            return line.split(":", 1)[1].strip(), args
    return None, args


def load_routes() -> dict:
    path = os.environ.get("FAKE_ASIDE_REPL_ROUTES")
    if not path:
        return {}
    return json.loads(Path(path).read_text(encoding="utf-8"))


def answer_for(snippet: str, url: str, route: object) -> dict | None:
    """A route's answer for this call, advancing a {"sequence": [...]} one step per call."""
    if isinstance(route, dict) and "sequence" in route:
        steps = route["sequence"]
        n = bump(f"{snippet} {url}")
        return steps[min(n, len(steps) - 1)]
    return route


def bump(key: str) -> int:
    """How many times this key was asked before, remembered across processes."""
    d = os.environ.get("FAKE_ASIDE_CALLS")
    if not d:
        return 0
    p = Path(d) / "repl_counts.json"
    counts = json.loads(p.read_text(encoding="utf-8")) if p.exists() else {}
    n = counts.get(key, 0)
    counts[key] = n + 1
    p.write_text(json.dumps(counts), encoding="utf-8")
    return n


def fetch_batch(args: dict, routes: dict):
    urls = args.get("urls") or []
    for u in urls:
        rec = answer_for("fetch_batch", u, routes.get(u))
        if rec is None:
            rec = {"status": 404, "content_type": "text/html", "kind": "text",
                   "text": "<html><body><h1>Not Found</h1></body></html>"}
        yield {"url": u, "final_url": u, **rec} if rec.get("kind") != "error" else {"url": u, **rec}
    yield {"kind": "batch_done", "requested": len(urls), "elapsed_ms": 1, "hit_budget": False}


def tab_one(args: dict, routes: dict):
    u = args.get("url") or ""
    rec = answer_for("tab_one", u, routes.get(u))
    if rec is None:
        rec = {"status": 0, "kind": "error", "error": "net::ERR_NAME_NOT_RESOLVED"}
    yield {"url": u, "final_url": u, "via": "tab", **rec}


def sitemap(args: dict, routes: dict):
    seen: list[str] = []
    for root in args.get("roots") or []:
        found = routes.get(root)
        if found is None:
            yield {"kind": "sitemap_miss", "url": root, "status": 404}
            continue
        for u in found:
            if u not in seen:
                seen.append(u)
                yield {"kind": "url", "url": u, "source": root}
    yield {"kind": "sitemap_done", "count": len(seen), "elapsed_ms": 1}


def links(args: dict, routes: dict):
    pages = args.get("pages") or []
    for page in pages:
        hrefs = routes.get(page)
        if hrefs is None:
            yield {"kind": "link_miss", "url": page, "status": 404}
            continue
        yield {"kind": "hrefs", "url": page, "final_url": page, "hrefs": list(hrefs)}
    yield {"kind": "links_done", "pages": len(pages), "elapsed_ms": 1, "hit_budget": False}


SNIPPETS = {"fetch_batch": fetch_batch, "tab_one": tab_one, "sitemap": sitemap, "links": links}


def main(argv: list[str]) -> int:
    record_call(argv)
    if len(argv) < 2:
        print("usage: aside <exec|repl|mcp|account> …", file=sys.stderr)
        return 2
    cmd = argv[1]
    positionals = [a for a in argv[2:] if not a.startswith("-")]
    flagged = {a for a in argv[2:] if a.startswith("-")}
    if "--version" in flagged or cmd == "--version":
        print(os.environ.get("FAKE_ASIDE_VERSION", "1.26.810.1915"))
        return 0
    if cmd == "exec":
        # --session <id> consumes the id, which would otherwise look like the prompt.
        session = None
        if "--session" in argv:
            i = argv.index("--session")
            session = argv[i + 1]
            positionals = [a for a in positionals if a != session]
        return do_exec(positionals[-1] if positionals else "", session)
    if cmd == "repl":
        return do_repl(positionals[-1] if positionals else "")
    if cmd == "mcp":
        print(json.dumps({"result": {"tools": [{"name": "repl", "description": "fake repl API description"}]}}))
        return 0
    if cmd == "account":
        # FAKE_ASIDE_ACCOUNTS=none is a signed-out browser: the command succeeds with an
        # empty roster, which is what the real one does.
        signed_out = os.environ.get("FAKE_ASIDE_ACCOUNTS") == "none"
        roster = [] if signed_out else [{"id": "u0", "status": "logged-in"}]
        print(json.dumps({"accounts": roster}))
        return 0
    print(f"unknown command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
