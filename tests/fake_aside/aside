#!/usr/bin/env python3
"""A stand-in for the `aside` binary.

It exists so the supervisor's state machine can be driven through situations the real
binary produces rarely or only by accident -- a run whose session never appears, a child
that outlives its parent, two identical prompts racing. Recording those as fixtures is
the only way to test them repeatedly.

Behaviour is chosen by FAKE_ASIDE_SCENARIO. Every invocation appends its argv to
$FAKE_ASIDE_CALLS/calls.jsonl so a contract test can assert what was actually run.

Transcripts are written in the format the real daemon has written since mid-September 2026: every
turn opens with a `turn-lifecycle` `started` record before its prompt, announces its last
message with `final-started`, and closes with `finished`. FAKE_ASIDE_FORMAT=legacy writes
the earlier format, which has none of these records.

A session is continued with `session resume <id> <prompt>`; `exec --session` is refused with
the usage error the real binary prints, since that binary dropped the option.

FAKE_ASIDE_REPLAY names a JSONL file of transcript records to write after the prompt,
for `exec` and for `session resume` alike; a `{"__sleep__": SEC}` line pauses
the writer, so a run can be held open at any point of its transcript, a
`{"__after_exit__": SEC}` line lets the process exit and has the rest written SEC later,
the way the daemon's last writes can land after `aside exec` has returned, and a record
carrying `"__if_prompt__": TEXT` is written only by a run whose prompt contains TEXT -- a
directive such as `__sleep__` too -- so the members of one group can write different transcripts. FAKE_ASIDE_PROMPT_DELAY holds a
resumed turn's prompt back that many seconds, the way a busy daemon lands it late.

A replay record carrying `"__session__": ID` goes to that session's transcript instead, made if it does not exist, so a replay can write its subagents' transcripts as they work -- before and after the process exits. A record `{"__artifact__": REL, "text": TEXT}` saves a file the agent made in the session's `artifacts/` instead of being written as a record -- `"link": TARGET` makes it a symlink, `"mode": N` sets its permissions -- or, for `{"__tmp__": REL, "bytes_b64": B64}`, a file in the session's `tmp/`, where Aside keeps what a webfetch downloaded, from these bytes or `"text"` -- and `__SESSION_DIR__` anywhere in a line becomes the session's directory -- `__SESSION_DIR:ID__` another session's -- so an answer can name files by absolute path. A `"timestamp": "__NOW__"` becomes the moment the record is written, and `{"__wait_for__": PATH}` holds the writer until PATH exists.

`repl` answers the page snippets from FAKE_ASIDE_REPL_ROUTES, a JSON file keyed by the
snippet named on the snippet's `// snippet: <name>` line and then by URL:

    fetch_batch, tab_one  URL -> a record, or {"sequence": [record, ...]} answered in
                          call order (the last one repeats). `url` is filled in. A
                          fetch_batch record with "bytes_from": PATH is a binary response:
                          it is answered as the snippet answers one, with that file's
                          bytes in base64 as body_b64.
    sitemap               candidate URL -> the page URLs that sitemap lists
    links                 page URL -> the raw hrefs on that page, or {"final_url": URL,
                          "hrefs": [...]} for a page that redirected there; "__hit_budget__":
                          true ends the call the way a snippet cut off by its budget does
    sitemap, links        "__timeout__": true dies the way the daemon's 120s snippet kill
                          does: no record reaches stdout, not even what was found first

A URL with no route answers as the real browser would: fetch_batch gets an HTTP 404
page, tab_one a navigation error, sitemap a miss, links a miss.

The commands that talk to the daemon fail the way the real CLI (1.26.1115) does, on stderr with exit 1: FAKE_ASIDE_SCENARIO=aside_down -- or a DAEMON_BASE_URL nothing accepts a TCP connection at -- is the daemon refusing the connection, aside_unreachable a connection that fails some other way, and repl_timeout, like a `"__timeout__"` route, the 120s snippet kill, which the real CLI words as that same other failure and which drops everything the snippet printed. Only ASIDE_DEBUG=1 adds the `Details:` line that says which, followed by a stack, as it does for the real one.

FAKE_ASIDE_OPENS=1 is a closed Aside the CLI opens: the first daemon command prints the CLI's line for that on stderr and then works. The fake opens nothing, so it says only what the CLI says, not that anything started; with a health stand-in that does not answer, it is "the daemon did not answer, and the round trip that followed worked". A repl that worked ends with the status line the real one prints on stderr.
"""
from __future__ import annotations

import base64
import json
import os
import random
import re
import socket
import string
import sys
import time
from pathlib import Path
from urllib.parse import urlparse

SCENARIO = os.environ.get("FAKE_ASIDE_SCENARIO", "simple")
LIFECYCLE = os.environ.get("FAKE_ASIDE_FORMAT", "lifecycle") != "legacy"
HOME = Path(os.environ.get("ULTRA_SEARCH_ASIDE_HOME", "~/.aside")).expanduser()
SESSIONS = HOME / "u" / "0" / "sessions"


def record_call(argv: list[str]) -> None:
    d = os.environ.get("FAKE_ASIDE_CALLS")
    if not d:
        return
    p = Path(d) / "calls.jsonl"
    p.parent.mkdir(parents=True, exist_ok=True)
    with p.open("a", encoding="utf-8") as f:
        env = {k: os.environ[k] for k in ("ASIDE_DEBUG", "DAEMON_BASE_URL") if k in os.environ}
        f.write(json.dumps({"argv": argv, "scenario": SCENARIO, "env": env, "at": time.time()}, ensure_ascii=False) + "\n")


def new_session_id() -> str:
    return "".join(random.choices(string.ascii_letters + string.digits, k=16))


def save_artifact(d: Path, rec: dict) -> None:
    """A file the agent saved, where the daemon keeps one: under the session's `artifacts/` for an `__artifact__`, under
    its `tmp/` -- where a webfetch's download or a result too large to keep inline lands -- for a `__tmp__`."""
    folder, key = ("tmp", "__tmp__") if "__tmp__" in rec else ("artifacts", "__artifact__")
    path = d / folder / rec[key]
    path.parent.mkdir(parents=True, exist_ok=True)
    if "link" in rec:
        path.symlink_to(rec["link"])
        return
    if "bytes_b64" in rec:
        path.write_bytes(base64.b64decode(rec["bytes_b64"]))
    else:
        path.write_text(rec.get("text", ""), encoding="utf-8")
    if "mode" in rec:
        os.chmod(path, int(rec["mode"]))


def session_dir(sid: str) -> Path:
    """Session ``sid``'s directory, made the way the daemon names one if it is not there yet."""
    for name in os.listdir(SESSIONS) if SESSIONS.is_dir() else []:
        if name.endswith("_" + sid):
            return SESSIONS / name
    d = SESSIONS / f"{time.strftime('%Y-%m-%d')}_{sid}"
    d.mkdir(parents=True, exist_ok=True)
    return d


def make_session(prompt: str, session_id: str | None = None) -> tuple[str, Path]:
    sid = session_id or new_session_id()
    d = SESSIONS / f"{time.strftime('%Y-%m-%d')}_{sid}"
    d.mkdir(parents=True, exist_ok=True)
    lifecycle(d, "started")
    append(d, opening_prompt(prompt))
    return sid, d


def opening_prompt(prompt: str) -> dict:
    return {"role": "user", "content": [{"type": "text", "text": prompt}], "timestamp": int(time.time() * 1000)}


def lifecycle(d: Path, event: str) -> None:
    """One `turn-lifecycle` record, in the format that writes them."""
    if LIFECYCLE:
        append(d, {"role": "turn-lifecycle", "event": event, "turnId": f"turn-{d.name}",
                   "timestamp": int(time.time() * 1000)})


def finish(d: Path, text: str, stop: str = "stop") -> None:
    """A turn's last message, framed the way the daemon frames it."""
    lifecycle(d, "final-started")
    append(d, assistant(texts=[text], stop=stop))
    lifecycle(d, "finished")


def append(d: Path, rec: dict) -> None:
    with (d / "messages.jsonl").open("a", encoding="utf-8") as f:
        f.write(json.dumps(rec, ensure_ascii=False) + "\n")
        f.flush()
        os.fsync(f.fileno())


def usage(total: int = 1000) -> dict:
    return {
        "input": total // 2, "output": 20, "cacheRead": 0, "cacheWrite": 0,
        "reasoning": 0, "totalTokens": total, "cost": {"total": 0.01},
    }


def assistant(texts=None, calls=None, stop="stop") -> dict:
    content = []
    for name, args in calls or []:
        content.append({"type": "toolCall", "name": name, "arguments": args})
    for t in texts or []:
        content.append({"type": "text", "text": t})
    return {"role": "assistant", "content": content, "stopReason": stop,
            "usage": usage(), "timestamp": int(time.time() * 1000)}


def tool_result(name: str, content: str, details: dict | None = None) -> dict:
    return {"role": "toolResult", "toolName": name, "content": content, "details": details or {},
            "isError": False, "toolCallId": "call_fake", "timestamp": int(time.time() * 1000)}


SEARCH_SOURCES = {"sources": [
    {"id": "src1", "url": "https://example.org/a", "title": "Example A", "excerpt": "…"},
    {"id": "src2", "url": "https://example.org/b", "title": "Example B", "excerpt": "…"},
]}


def replay(d: Path, prompt: str) -> bool:
    """Write the records from FAKE_ASIDE_REPLAY after the prompt already in ``d``.

    A recorded session's own opening prompt is skipped, with the `started` record before it:
    the prompt this run was given, with its marker, is already there, exactly as the real
    binary writes it. A recording made before the lifecycle records existed gets its turn
    closed with `finished` when it ends on a finished answer, as the daemon would close it
    now; one that ends mid-work stays open. A recording that ends without a newline ends the
    same way here -- half a record, as a transcript looks while its writer is mid-line.
    """
    source = os.environ.get("FAKE_ASIDE_REPLAY")
    if not source:
        return False
    text = Path(source).read_text(encoding="utf-8")
    # One record per "\n", as Aside writes them: JSON leaves U+0085, U+2028 and U+2029 unescaped inside a string.
    lines = text.split("\n")
    opening = True
    recorded_lifecycle = False
    answered = False
    for i, line in enumerate(lines):
        if not line.strip():
            continue
        line = line.replace("__SESSION_DIR__", str(d))
        line = re.sub(r"__SESSION_DIR:(\w+)__", lambda m: str(session_dir(m.group(1))), line)
        try:
            rec = json.loads(line)
        except ValueError:
            rec = None
        if isinstance(rec, dict) and rec.get("timestamp") == "__NOW__":
            rec["timestamp"] = int(time.time() * 1000)
            line = json.dumps(rec, ensure_ascii=False)
        if isinstance(rec, dict) and "__if_prompt__" in rec:
            if str(rec.pop("__if_prompt__")) not in prompt:
                continue
            line = json.dumps(rec, ensure_ascii=False)
        role = rec.get("role") if isinstance(rec, dict) else None
        if isinstance(rec, dict) and "__sleep__" in rec:
            time.sleep(float(rec["__sleep__"]))
            continue
        if isinstance(rec, dict) and "__wait_for__" in rec:
            gate = Path(rec["__wait_for__"])
            until = time.time() + 30
            while not gate.exists() and time.time() < until:
                time.sleep(0.01)
            continue
        if isinstance(rec, dict) and "__after_exit__" in rec:
            if os.fork() != 0:
                return True
            time.sleep(float(rec["__after_exit__"]))
            continue
        if isinstance(rec, dict) and "__session__" in rec:
            target = session_dir(str(rec.pop("__session__")))
            if "__artifact__" in rec or "__tmp__" in rec:
                save_artifact(target, rec)
            else:
                append(target, rec)
            continue
        if isinstance(rec, dict) and ("__artifact__" in rec or "__tmp__" in rec):
            save_artifact(d, rec)
            continue
        if role == "turn-lifecycle":
            recorded_lifecycle = True
            if opening:
                continue
        if opening and role == "user":
            opening = False
            continue
        if role in ("assistant", "toolResult"):
            opening = False
        torn = i == len(lines) - 1 and not text.endswith("\n")
        with (d / "messages.jsonl").open("a", encoding="utf-8") as f:
            f.write(line if torn else line + "\n")
        answered = role == "assistant" and rec.get("stopReason") not in (None, "", "toolUse") and not torn
    if not recorded_lifecycle and answered:
        lifecycle(d, "finished")
    return True


def do_exec(prompt: str, session: str | None = None) -> int:
    if session:
        # Continuing an existing session: append to its transcript rather than creating a
        # new one. The real binary does this, and a fake that made a fresh session instead
        # would hide the fact that marker discovery cannot work on a resumed run.
        d = None
        for name in os.listdir(SESSIONS) if SESSIONS.is_dir() else []:
            if name.endswith("_" + session):
                d = SESSIONS / name
                break
        if d is None:
            print(f"no such session {session}", file=sys.stderr)
            return 1
        time.sleep(float(os.environ.get("FAKE_ASIDE_PROMPT_DELAY", "0")))
        opening = opening_prompt(prompt)
        # FAKE_ASIDE_RESUME_LATE=1 lands the whole turn, prompt included, after this process
        # has exited: the transcript then shows only earlier turns for a while.
        late = os.environ.get("FAKE_ASIDE_RESUME_LATE") == "1"
        if not late:
            lifecycle(d, "started")
            append(d, opening)
            if replay(d, prompt):
                return 0
        answer = "이어서 답합니다."
        # The reply can land after this process exits -- which is exactly when a supervisor
        # that stopped waiting would report the previous turn's answer instead.
        delay = float(os.environ.get("FAKE_ASIDE_RESUME_DELAY", "0"))
        if delay:
            if os.fork() == 0:
                time.sleep(delay)
                if late:
                    lifecycle(d, "started")
                    append(d, opening)
                finish(d, answer)
                os._exit(0)
        else:
            finish(d, answer)
        print(answer)
        return 0

    if SCENARIO == "no_session":
        # The session never appears on disk: the supervisor has to fall back to stdout
        # alone rather than waiting forever for a correlation that will not happen. What is
        # printed is shaped like the real binary's stdout -- a tool call in colour, its
        # output dimmed, then the final message -- or is a recording of it, given as
        # FAKE_ASIDE_STDOUT.
        recorded = os.environ.get("FAKE_ASIDE_STDOUT")
        if recorded:
            sys.stdout.write(Path(recorded).read_text(encoding="utf-8"))
            return 0
        print("\x1b[32mwebsearch\x1b[0m(objective: \x1b[32m'x'\x1b[39m)\n")
        print("\x1b[2m > {\"session_id\":\"unknowable\",\"results\":[{\"url\":\"https://example.org/only-in-stdout\"}]}\x1b[0m")
        sys.stdout.flush()
        time.sleep(float(os.environ.get("FAKE_ASIDE_DELAY", "0.3")))
        print("The answer, visible only in stdout.\x1b[0m")
        return 0

    if SCENARIO == "late_session":
        # The process prints its answer and exits before its session is on disk: the daemon's
        # writes land after `aside exec` has returned, here FAKE_ASIDE_DELAY seconds later.
        answer = 'Answer <citation refs="src1">Example A</citation>'
        print(answer)
        sys.stdout.flush()
        if os.fork() == 0:
            time.sleep(float(os.environ.get("FAKE_ASIDE_DELAY", "1.5")))
            _, d = make_session(prompt)
            append(d, assistant(calls=[("websearch", {"objective": "o", "search_queries": ["q"]})], stop="toolUse"))
            append(d, tool_result("websearch", "results…", SEARCH_SOURCES))
            finish(d, answer)
            os._exit(0)
        return 0

    sid, d = make_session(prompt)
    print(f"Thinking: starting {sid}")
    sys.stdout.flush()

    if replay(d, prompt):
        # FAKE_ASIDE_EXIT is the code a replayed run exits with, so an exit can disagree with the transcript.
        return int(os.environ.get("FAKE_ASIDE_EXIT", "0"))

    if SCENARIO == "slow":
        delay = float(os.environ.get("FAKE_ASIDE_DELAY", "3"))
        append(d, assistant(calls=[("websearch", {"objective": "slow", "search_queries": ["q"]})], stop="toolUse"))
        time.sleep(delay)
        append(d, tool_result("websearch", "results…", SEARCH_SOURCES))
        finish(d, "느린 답.")
        print("느린 답.")
        return 0

    if SCENARIO in ("subagent", "orphan"):
        children = []
        append(d, assistant(calls=[("subagent", {"action": "spawn", "description": "c1"}),
                                   ("subagent", {"action": "spawn", "description": "c2"})], stop="toolUse"))
        for name in ("c1", "c2"):
            cid, cd = make_session(f"child task {name}")
            children.append((cid, cd))
            append(d, tool_result("subagent", "spawned", {"taskId": cid}))
        # One child finishes promptly; in the orphan scenario the other is still writing
        # when the parent process exits, which is exactly the case that must not be
        # reported as a clean completion.
        finish(children[0][1], "child 1 done.")
        if SCENARIO == "subagent":
            finish(children[1][1], "child 2 done.")
            finish(d, "부모 답: 자식 둘 완료.")
            print("부모 답: 자식 둘 완료.")
            return 0
        os.environ["FAKE_ASIDE_ORPHAN_DIR"] = str(children[1][1])
        pid = os.fork()
        if pid == 0:
            time.sleep(float(os.environ.get("FAKE_ASIDE_ORPHAN_DELAY", "2")))
            finish(children[1][1], "child 2 finished late.")
            os._exit(0)
        finish(d, "부모 답: 자식 하나가 아직.")
        print("부모 답: 자식 하나가 아직.")
        return 0

    if SCENARIO == "fail":
        finish(d, "", stop="error")
        print("something went wrong", file=sys.stderr)
        return 1

    if SCENARIO == "empty":
        finish(d, "")
        return 0

    if SCENARIO == "negative":
        answer = "관련 사례를 찾지 못했습니다."
        finish(d, answer)
        print(answer)
        return 0

    # simple
    append(d, assistant(calls=[("websearch", {"objective": "o", "search_queries": ["q"]})], stop="toolUse"))
    append(d, tool_result("websearch", "results…", SEARCH_SOURCES))
    answer = 'Answer <citation refs="src1">Example A</citation>'
    finish(d, answer)
    print(answer)
    return 0


def do_repl(code: str) -> int:
    if SCENARIO == "repl_timeout":
        time.sleep(float(os.environ.get("FAKE_ASIDE_DELAY", "0.2")))
        return snippet_killed()

    snippet, args = snippet_of(code)
    if snippet is None:
        # The fake does not run JavaScript. The one untagged program it answers is doctor's
        # round trip, with what that program really prints; anything else is refused rather
        # than answered with output the real sandbox would never produce.
        if code.strip() == DOCTOR_PROBE:
            # FAKE_ASIDE_REPL_PROBE=fail is a sandbox that answers but refuses to run it.
            if os.environ.get("FAKE_ASIDE_REPL_PROBE") == "fail":
                print(json.dumps({"ok": False, "error": "sandbox refused the snippet"}))
                return 1
            print(json.dumps({"ok": True}))
            print("[ok | 1ms]", file=sys.stderr)
            return 0
        print("the fake aside cannot evaluate arbitrary JavaScript", file=sys.stderr)
        return 2
    routes = load_routes().get(snippet) or {}
    if routes.get("__timeout__"):
        # Killed before its closing record, and nothing it printed reaches stdout.
        return snippet_killed()
    for rec in SNIPPETS[snippet](args, routes):
        print(json.dumps(rec, ensure_ascii=False))
        sys.stdout.flush()
    print("[ok | 1ms]", file=sys.stderr)
    return 0


DEFAULT_DAEMON = "http://127.0.0.1:21420"
REMOTE_HINT = ("  - Or control another machine / Aside Cloud instead: run 'aside login' once, then "
               "'aside exec --host <host>' (see 'aside host list').")


def daemon_base() -> str:
    return (os.environ.get("DAEMON_BASE_URL") or DEFAULT_DAEMON).rstrip("/")


def cli_error(said: str, cause: str) -> int:
    """A daemon error as the real CLI prints it: the message and the remote-host hint, then -- under ASIDE_DEBUG=1 --
    the cause and a stack that repeats both."""
    lines = [f"Error: {said}", REMOTE_HINT]
    if os.environ.get("ASIDE_DEBUG") == "1":
        lines += [f"Details: {cause}", f"TRPCClientError: {said}", REMOTE_HINT, f"Details: {cause}",
                  "    at TRPCClientError.from (file:///fake/aside:1:1)"]
    print("\n".join(lines), file=sys.stderr)
    return 1


def refused() -> int:
    return cli_error(
        "Aside isn't running on this machine. Ask the user to open Aside, then retry the same command. Don't switch "
        "to another browser: only Aside has the user's logged-in sessions.",
        f"Failed to request daemon auth challenge: fetch failed: connect ECONNREFUSED {urlparse(daemon_base()).netloc}")


def unreachable(cause: str = "Failed to request daemon auth challenge: fetch failed: bad port") -> int:
    return cli_error(f"Could not connect to Aside at {daemon_base()}. Check the browser and local network permissions.",
                     cause)


def snippet_killed() -> int:
    """The 120s snippet kill, worded by the real CLI as a connection it could not make; only its cause says otherwise."""
    return unreachable("fetch failed: other side closed")


def daemon_refuses() -> bool:
    """Whether DAEMON_BASE_URL, when it is set, accepts no TCP connection -- not whether a daemon answers there, and not
    the ports Node's fetch refuses before connecting (9, for one), which the real CLI words as aside_unreachable. Left
    unset, the fake stands in for a daemon that is up, and never touches the real one's port."""
    base = os.environ.get("DAEMON_BASE_URL")
    if not base:
        return False
    u = urlparse(base)
    try:
        socket.create_connection((u.hostname or "127.0.0.1", u.port or 80), timeout=2).close()
        return False
    except OSError:
        return True


DOCTOR_PROBE = "console.log(JSON.stringify({ok:true}));"


def snippet_of(code: str) -> tuple[str | None, dict]:
    """The snippet named by its tag line, and the ARGS the caller prepended."""
    lines = code.splitlines()
    args: dict = {}
    if lines and lines[0].startswith("const ARGS = "):
        args = json.loads(lines[0][len("const ARGS = "):].rstrip().rstrip(";"))
    for line in lines[:3]:
        if line.startswith("// snippet:"):
            return line.split(":", 1)[1].strip(), args
    return None, args


def load_routes() -> dict:
    path = os.environ.get("FAKE_ASIDE_REPL_ROUTES")
    if not path:
        return {}
    return json.loads(Path(path).read_text(encoding="utf-8"))


def answer_for(snippet: str, url: str, route: object) -> dict | None:
    """A route's answer for this call, advancing a {"sequence": [...]} one step per call."""
    if isinstance(route, dict) and "sequence" in route:
        steps = route["sequence"]
        n = bump(f"{snippet} {url}")
        return steps[min(n, len(steps) - 1)]
    return route


def bump(key: str) -> int:
    """How many times this key was asked before, remembered across processes."""
    d = os.environ.get("FAKE_ASIDE_CALLS")
    if not d:
        return 0
    p = Path(d) / "repl_counts.json"
    counts = json.loads(p.read_text(encoding="utf-8")) if p.exists() else {}
    n = counts.get(key, 0)
    counts[key] = n + 1
    p.write_text(json.dumps(counts), encoding="utf-8")
    return n


def fetch_batch(args: dict, routes: dict):
    urls = args.get("urls") or []
    for u in urls:
        rec = answer_for("fetch_batch", u, routes.get(u))
        if rec is None:
            rec = {"status": 404, "content_type": "text/html", "kind": "text",
                   "text": "<html><body><h1>Not Found</h1></body></html>"}
        if "bytes_from" in rec:
            rec = {k: v for k, v in rec.items() if k != "bytes_from"} | {
                "body_b64": base64.b64encode(Path(rec["bytes_from"]).read_bytes()).decode("ascii")}
        yield {"url": u, "final_url": u, **rec} if rec.get("kind") != "error" else {"url": u, **rec}
    yield {"kind": "batch_done", "requested": len(urls), "elapsed_ms": 1, "hit_budget": False}


def tab_one(args: dict, routes: dict):
    u = args.get("url") or ""
    rec = answer_for("tab_one", u, routes.get(u))
    if rec is None:
        rec = {"status": 0, "kind": "error", "error": "net::ERR_NAME_NOT_RESOLVED"}
    yield {"url": u, "final_url": u, "via": "tab", **rec}


def sitemap(args: dict, routes: dict):
    seen: list[str] = []
    for root in args.get("roots") or []:
        found = routes.get(root)
        if found is None:
            yield {"kind": "sitemap_miss", "url": root, "status": 404}
            continue
        for u in found:
            if u not in seen:
                seen.append(u)
                yield {"kind": "url", "url": u, "source": root}
    yield {"kind": "sitemap_done", "count": len(seen), "elapsed_ms": 1}


def links(args: dict, routes: dict):
    pages = args.get("pages") or []
    cut = bool(routes.get("__hit_budget__"))
    for page in pages:
        hrefs = routes.get(page)
        if hrefs is None:
            yield {"kind": "link_miss", "url": page, "status": 404}
            continue
        moved = hrefs if isinstance(hrefs, dict) else {"final_url": page, "hrefs": hrefs}
        yield {"kind": "hrefs", "url": page, "final_url": moved["final_url"], "hrefs": list(moved["hrefs"])}
    yield {"kind": "links_done", "pages": len(pages), "elapsed_ms": 1, "hit_budget": cut}


SNIPPETS = {"fetch_batch": fetch_batch, "tab_one": tab_one, "sitemap": sitemap, "links": links}


def main(argv: list[str]) -> int:
    record_call(argv)
    if len(argv) < 2:
        print("usage: aside <exec|repl|account> …", file=sys.stderr)
        return 2
    cmd = argv[1]
    positionals = [a for a in argv[2:] if not a.startswith("-")]
    flagged = {a for a in argv[2:] if a.startswith("-")}
    if "--version" in flagged or cmd == "--version":
        print(os.environ.get("FAKE_ASIDE_VERSION", "1.26.1115.1556"))
        return 0
    if cmd in ("exec", "session", "repl", "account"):
        if SCENARIO == "aside_down" or daemon_refuses():
            return refused()
        if SCENARIO == "aside_unreachable":
            return unreachable()
        if os.environ.get("FAKE_ASIDE_OPENS") == "1" and bump("__opened__") == 0:
            print("Aside isn't running. Opening it in the background...", file=sys.stderr)
    if cmd == "exec":
        if "--session" in argv:
            print("Error: Unknown option '--session'\n(add --help for usage)", file=sys.stderr)
            return 2
        return do_exec(positionals[-1] if positionals else "")
    if cmd == "session" and positionals[:1] == ["resume"] and len(positionals) >= 2:
        unknown = sorted(flagged - {"--account"})
        if unknown:
            print(f"Error: Unknown option '{unknown[0]}'\n(add --help for usage)", file=sys.stderr)
            return 2
        return do_exec(positionals[2] if len(positionals) > 2 else "", positionals[1])
    if cmd == "repl":
        return do_repl(positionals[-1] if positionals else "")
    if cmd == "account":
        # FAKE_ASIDE_ACCOUNTS=none is no account at all: the command succeeds with an empty roster. Not measured; a signed-out account is still listed by the real one.
        signed_out = os.environ.get("FAKE_ASIDE_ACCOUNTS") == "none"
        roster = [] if signed_out else [{"id": "u0", "status": "logged-in"}]
        print(json.dumps({"accounts": roster}))
        return 0
    print(f"unknown command {cmd}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
